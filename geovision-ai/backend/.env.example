# GeoVision AI - Environment Configuration

# Copernicus Data Space Ecosystem (CDSE) Credentials (Optional)
# If provided, live tokenized requests are authenticated directly against https://identity.dataspace.copernicus.eu
CDSE_CLIENT_ID=your_copernicus_client_id_here
CDSE_CLIENT_SECRET=your_copernicus_client_secret_here

# Optional: Custom STAC endpoint (defaults to Element84 Earth Search AWS Sentinel-2 L2A STAC)
SENTINEL_STAC_URL=https://earth-search.aws.element84.com/v1/search

# Server Configuration
PORT=8000
HOST=0.0.0.0
ALLOWED_ORIGINS=https://geovision-ai-frontend-pragya.onrender.com,http://localhost:5173
